APP_NAME=A&M FutureTech AI Assistant API
USE_MOCK_AI=true
DATABASE_PATH=data/chatbot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.example.com
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=replace-with-server-side-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
CHAT_CONTEXT_LIMIT=20
UPLOAD_ROOT=data/uploads
MAX_UPLOAD_BYTES=10485760
DOCUMENT_CHUNK_CHARS=3500
DOCUMENT_RETRIEVAL_CHUNKS=4
MEMORY_RETRIEVAL_LIMIT=6
SESSION_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
SESSION_EXPIRE_HOURS=168
RESET_TOKEN_MINUTES=30
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///data/chatbot.db
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
MAX_REQUEST_BYTES=12582912
LOGIN_RATE_LIMIT=5
REGISTRATION_RATE_LIMIT=3
RESET_RATE_LIMIT=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
OCR_ENABLED=true
TESSERACT_CMD=
POPPLER_PATH=
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_PDF_PAGES=30
